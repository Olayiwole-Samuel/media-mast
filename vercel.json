{
    "services": {
        "frontend": {
            "root": "frontend/",
            "framework": "nextjs"
        },
        "backend": {
            "root": "backend/",
            "entrypoint": "server.js"
        }
    },
    "rewrites": [
        {
            "source": "/api/v1/:path*",
            "destination": {
                "service": "backend"
            }
        },
        {
            "source": "/health",
            "destination": {
                "service": "backend"
            }
        },
        {
            "source": "/(.*)",
            "destination": {
                "service": "frontend"
            }
        }
    ]
}
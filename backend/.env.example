# Media Masters backend — settings (copy to .env locally; set the same names in Vercel).
# Placeholders only. Never commit real values.

# ── Required ──
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
JWT_SECRET=<long-random-string>
JWT_EXPIRE=7d

# ── Email (Resend). Leave both empty to send no email (the app still works). ──
RESEND_API_KEY=
# A sender on a domain you verified in Resend, e.g. Media Masters <no-reply@yourdomain.com>
MAIL_FROM=
# Frontend address used in email links (reset password, invitations, bookings).
APP_URL=https://media-masters-x.vercel.app

# ── Payments ──
# stub = test mode, no money moves (the only provider today). Unknown values make checkout refuse.
PAYMENT_PROVIDER=stub
# Platform fee added at checkout, in percent (0 = none).
PLATFORM_FEE_PERCENT=0

# ── Off by default; only for tests or a deliberate admin need ──
# true re-enables POST /api/v1/bookings (an unpaid booking that skips checkout).
ALLOW_DIRECT_BOOKING=

# ── First admin (used once by: node src/scripts/createAdmin.js) ──
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Media Masters Admin

# ── Local only ──
PORT=5000

# ── Subscriptions & discounts ──
# Advertisers need an active plan to check out (set false to switch off).
SUBSCRIPTION_REQUIRED=true
# Multi-station discount tiers, "stations:percent" pairs.
MULTI_STATION_DISCOUNTS=3:5,5:10

# ── Reminders & SMS ──
# Secret for POST /api/v1/jobs/reminders (at least 16 characters).
CRON_SECRET=
# Termii SMS; leave empty to send no SMS.
TERMII_API_KEY=
TERMII_SENDER_ID=
TERMII_BASE_URL=https://api.ng.termii.com
